# Wallet mnemonics — bots no longer auto-generate on first run.
# If data/<bot>/data/wallet.json doesn't exist, the matching *_MNEMONIC env var
# below MUST be set or the bot will refuse to start. Once the wallet is on disk,
# the env var is optional (kept as a backup for recovery from corruption).

# ── testnet2 network + wallet-api (shared) ─────────────────────────────
# All bots run on testnet2. The v2 token engine needs an aggregator API key.
AGGREGATOR_KEY=
# Only chess-bot moves money, so only it needs the wallet-api rail. The
# messaging bots (kbbot, viktor, unicity-l3) compose `walletApi: 'none'`
# (sphere-sdk >= 0.17.3) and need no wallet-api deployment or device id at all.
# WALLET_API_URL must be https off-loopback (bots need outbound HTTPS egress).
# It must be the wallet-api the players' wallets use, or rewards are deposited
# where nobody claims them: wallet-api.unicity.network for the testnet2
# sphere.unicity.network wallet (staging is a separate database).
# CHESS_BOT_DEVICE_ID is the stable device label (see docker-compose tmpfs note).
WALLET_API_URL=https://wallet-api.unicity.network
CHESS_BOT_NETWORK=testnet2
CHESS_BOT_DEVICE_ID=chess-bot-prod-1

# KBBot — Knowledge Base Bot (Nostr DM-based)
KBBOT_LLM_PROVIDER=openai-compatible
KBBOT_LLM_API_KEY=your_arliai_api_key_here
KBBOT_LLM_MODEL=Gemma-4-31B-it
KBBOT_LLM_BASE_URL=https://api.arliai.com/v1
# KBBOT_LLM_TEMPERATURE=            # optional; omit to use the model default
# Senders to silently block, comma-separated @nametags or 64-hex pubkeys:
# KBBOT_BLOCKLIST=@somebot,@another
# Per-sender inbound DM rate limit (defaults: 30 msgs / 300s; MAX=0 disables):
# KBBOT_RATE_LIMIT_MAX=30
# KBBOT_RATE_LIMIT_WINDOW_SEC=300
# Should be unique name
KBBOT_NAMETAG=kbbot
KBBOT_NETWORK=testnet2
# KBBOT_MNEMONIC=
# KBBOT_MAX_HISTORY_MESSAGES=20

# Viktor — DM-based research assistant
VIKTOR_LLM_PROVIDER=openai-compatible
VIKTOR_LLM_API_KEY=your_llm_api_key_here
VIKTOR_LLM_MODEL=gpt-oss
VIKTOR_LLM_BASE_URL=https://api.openai.com/v1
# VIKTOR_LLM_TEMPERATURE=0.6        # optional; default 0.6
# Should be unique name
VIKTOR_NAMETAG=viktor
VIKTOR_NETWORK=testnet2
# VIKTOR_MNEMONIC=

# Chess bot — plays games over Sphere group chat
# CHESS_BOT_NAMETAG=chess-bot
# CHESS_BOT_GROUP_ID=chess
# CHESS_BOT_MNEMONIC=

# SearXNG search endpoint (used by mcp-web; default points to internal Docker service)
SEARXNG_URL=http://searxng:8080
# SEARXNG_KEY=

# Unicity L3 — Block info poster to Sphere group chat
L3_GROUP_ID=                         # Required: Sphere group chat ID
L3_NAMETAG=unicity-l3
L3_NETWORK=testnet2
# L3_MNEMONIC=
# testnet2 block-info aggregator (verify it serves /config/shards + get_block):
# L3_AGGREGATOR_URL=https://gateway.testnet2.unicity.network/
# L3_EXPLORER_BASE_URL=https://unicitynetwork.github.io/smt-explorer/
# L3_POLL_INTERVAL_MS=10000

# Unicity Oracle debug logging
# ORACLE_DEBUG=true
